# Backend Laravel ejecutado FUERA de Docker (opcional). Con Docker se usa el .env de la raíz.
APP_NAME="SABITECH WEB"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_DISPLAY_TIMEZONE=Europe/Madrid

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sabitech
DB_USERNAME=sabitech
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# QR temporal: generar con  openssl rand -base64 32
QR_SIGNING_KEY=
QR_TTL_SECONDS=30
QR_LEEWAY_SECONDS=5

# Correo de laboratorio (buzón SMTP de pruebas). Con MAIL_MAILER=log los correos van al log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@sabitech.test"
MAIL_FROM_NAME="${APP_NAME}"
