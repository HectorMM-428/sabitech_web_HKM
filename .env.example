# SABITECH WEB · variables de entorno (ejemplo SIN secretos reales)
# Copiar a .env y rellenar. El fichero .env NUNCA se sube al repositorio.

# --- Aplicación ---
APP_NAME="SABITECH WEB"
APP_ENV=production
APP_DEBUG=false
# Generar con: docker compose run --rm back php artisan key:generate --show
APP_KEY=
APP_DOMAIN=sabitech.test
APP_URL=https://sabitech.test
FRONTEND_URL=https://sabitech.test
# Zona horaria de presentación (en BD todo va en UTC)
APP_DISPLAY_TIMEZONE=Europe/Madrid

# --- Base de datos (contenedor db) ---
DB_DATABASE=sabitech
DB_USERNAME=sabitech
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Sesión y Sanctum ---
SESSION_LIFETIME=120
SESSION_DOMAIN=sabitech.test

# --- QR temporal ---
# 32 bytes aleatorios en base64. Generar con: openssl rand -base64 32
QR_SIGNING_KEY=
QR_TTL_SECONDS=30
QR_LEEWAY_SECONDS=5

# --- Correo de laboratorio (buzón SMTP de pruebas externo, K-10) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=no-reply@sabitech.test
MAIL_FROM_NAME="SABITECH WEB"

# --- Registros ---
LOG_CHANNEL=stack
LOG_LEVEL=info
